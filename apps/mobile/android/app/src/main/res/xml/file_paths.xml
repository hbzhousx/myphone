<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- OTA 下载的 APK 存于应用文档目录(files 下),需暴露给系统安装器 -->
    <files-path name="apks" path="." />
    <!-- 聊天附件明文存于 getApplicationDocumentsDirectory()(Android = getDir("flutter")),
         路径可能是 /data/user/0/<pkg>/app_flutter/ 或 /data/data/<pkg>/app_flutter/
         （两前缀为同一物理目录的符号链接/别名）。FileProvider 用 canonical path 匹配
         root，之前用 <root-path path="app_flutter/"> 只匹配 /data/user/0 前缀，
         在返回 /data/data 前缀的设备上抛 "Failed to find configured root"。
         社区标准解法(StackOverflow): <root-path path="." /> 暴露整个应用私有根，
         canonical 后两前缀都能匹配。生产可收窄到具体子目录。 -->
    <root-path name="root" path="." />
    <!-- 发送方源文件(file_picker 选中的文件)在 cache 目录,需暴露 -->
    <cache-path name="cache" path="." />
</paths>
