# ============================================================
# 本地打包配置模板（在开发机执行 build-apk.sh 时使用）
# 使用方法：cp build.env.example .env.local  然后填写
# .env.local 已被 .gitignore 忽略，不会入库。
# ============================================================

# 阿里云服务器公网 IP
MYPHONE_SERVER_HOST=1.2.3.4

# 临时无域名方案：HTTP + 80 端口（Nginx 前置）
MYPHONE_SERVER_PORT=80
MYPHONE_SERVER_TLS=false
# 将来拿到域名启用 HTTPS 后改为：
# MYPHONE_SERVER_PORT=443
# MYPHONE_SERVER_TLS=true

# 自建 coturn（必须与服务器 /etc/turnserver.conf 完全一致）
MYPHONE_STUN_URL=stun:1.2.3.4:3478
# ★重要：必须加 ?transport=tcp。
#   手机(尤其国内运营商)常限制 App 的 UDP 出站，导致 TURN(UDP 3478)不可用、跨网络通话失败。
#   用 TCP 传输 TURN 可绕过 UDP 限制，且 coturn 需同时监听 TCP 3478。
MYPHONE_TURN_URL=turn:1.2.3.4:3478?transport=tcp
MYPHONE_TURN_USERNAME=myphone
# 填服务器上 install-deps.sh 生成的 MYPHONE_TURN_PASSWORD
MYPHONE_TURN_CREDENTIAL=填入随机密码

# 注：App 端已强制 iceTransportPolicy=relay(只走 TURN)，跨 NAT 场景媒体必走中继，避免
#   host/srflx 直连失败。此逻辑在 apps/mobile/lib/core/webrtc/webrtc_manager.dart 内，无需改动。
