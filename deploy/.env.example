# ============================================================
# 服务器端环境变量模板（仅供格式参考）
# 实际文件由 install-deps.sh 自动生成到 /etc/myphone/myphone.env，
# 密码为随机生成，请勿手动创建本文件。
#
# 注意：systemd 的 EnvironmentFile 不做变量展开，
#       因此 DATABASE_URL 必须是展开后的完整字符串。
# ============================================================

# Go 服务端连接 PostgreSQL 的完整 DSN
DATABASE_URL=postgres://myphone:<随机密码>@127.0.0.1:5432/myphone?sslmode=disable

# Redis 地址（仅监听本机）
REDIS_ADDR=127.0.0.1:6379

# Go 服务端监听端口（仅本机回环，外部统一走 Nginx 80/443）
PORT=8080

# 以下为运维参考值（install-deps.sh 生成）
MYPHONE_DB_PASSWORD=<随机密码>
# TURN 服务器静态凭据密码 —— 打包生产 APK 时需填到本地 build.env 的 MYPHONE_TURN_CREDENTIAL
MYPHONE_TURN_PASSWORD=<随机密码>
# 公网 IP（可选，用于 coturn external-ip 中继地址）
MYPHONE_PUBLIC_IP=<公网IP>

# ---- v1.50 AI 语音通话（媒体端点）----
AGENT_MEDIA_WS_URL=ws://127.0.0.1:8090/bridge
AGENT_BRIDGE_TOKEN=<随机密码，与 install-deps.sh 生成的 BRIDGE_TOKEN 一致>
AGENT_LISTEN_ADDR=127.0.0.1:8090
# AGENT_ASR_URL=ws://asr.example.com/stream
# AGENT_TTS_URL=https://tts.example.com/synthesize
# AGENT_TEXT_URL=https://agent.example.com/chat

# ---- v1.50+ 方案 A：qwen-audio-agent 语音引擎 ----
AGENT_GATEWAY_URL=ws://127.0.0.1:3101/api/realtime
# AGENT_GATEWAY_SESSION_ID=user_personal
# ---- 后台 Agent（可选）----
# AGENT_PROTOCOL=hermes
# HERMES_BIN=/usr/local/bin/hermes
